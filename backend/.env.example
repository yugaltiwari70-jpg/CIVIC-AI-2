PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/civicai
CLIENT_URL=http://localhost:5173
JWT_SECRET=change-me-long-random-string-at-least-32-chars
ADMIN_EMAIL=admin@civicai.demo
ADMIN_PASSWORD=choose-a-secure-password
